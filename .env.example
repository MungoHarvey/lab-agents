# Lab Agents Configuration
# Copy to .env and fill in values

# LabStep API (required)
# Get from: https://app.labstep.com → Settings → API
LABSTEP_API_KEY=

# GitHub (required)
# Create PAT at: https://github.com/settings/tokens
# Needs: read:org, repo (for private repos)
GITHUB_TOKEN=

# Slack Bot (optional — omit for CLI-only output)
# Create app at: https://api.slack.com/apps
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# RDS path (optional — if mounted)
# e.g., /Volumes/rds/neurogenomics or /mnt/rds/neurogenomics
RDS_PATH=

# Metadata catalog location
CATALOG_DB=~/.lab-agents/catalog.db

# GitHub org to scan
GITHUB_ORG=neurogenomics

# Thresholds (days)
MISSING_DATA_THRESHOLD=7
STALE_ANALYSIS_THRESHOLD=90
STALE_WRITEUP_THRESHOLD=90
QUIET_PROJECT_THRESHOLD=30
